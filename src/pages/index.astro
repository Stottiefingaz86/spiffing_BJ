---
import Layout from '@/layouts/Layout.astro';
import { LobbySidebar } from '@/components/lobby/LobbySidebar';
import { ScrollKnockoutHeadline } from '@/components/lobby/ScrollKnockoutHeadline';

type LobbyTileBg =
  | { type: 'image'; src: string }
  | { type: 'blackjack' }
  | { type: 'dealr' };

interface GameDetailBlock {
  title: string;
  detail: string;
}

interface GameTile {
  id: string;
  title: string;
  subtitle: string;
  href: string;
  category: string;
  tileBg?: LobbyTileBg;
  logo?: string;
  /** Extra-large tile logo (assets with heavy padding) */
  logoLarge?: boolean;
  /** Compact tile logo (wide/tight crops that read too big) */
  logoCompact?: boolean;
  icon: string;
  available: boolean;
  /** Tags for lobby filters: slots | table | exclusive */
  filterTags: string[];
  /** Higher = newer; used for “Release date” sort */
  releaseOrder: number;
  /** Show orange New badge */
  isNew?: boolean;
  /** Show Fire badge */
  isFire?: boolean;
  /** Demo RTP label shown on the tile footer */
  rtp: string;
  /** Volatility 1–5 (filled lightning bolts on the tile) */
  volatility: 1 | 2 | 3 | 4 | 5;
  /** Netflix-style detail modal copy */
  description: string;
  specs: string[];
  paytable: GameDetailBlock[];
  bonuses: GameDetailBlock[];
}

const games: GameTile[] = [
  {
    id: 'dealr',
    title: 'AI Live Dealrs',
    subtitle: 'Live Blackjack · AI Dealer Isla · Real Table',
    href: 'https://livedealr-ten.vercel.app/real',
    category: 'Live table',
    tileBg: { type: 'dealr' },
    logo: '/dealr/logo.png',
    logoCompact: true,
    icon: '🂡',
    available: true,
    filterTags: ['table', 'exclusive'],
    releaseOrder: 99,
    isNew: true,
    rtp: '99.50%',
    volatility: 2,
