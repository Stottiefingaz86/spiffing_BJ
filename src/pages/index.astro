      { title: 'Symbol cast', detail: 'Bullion, flask, dynamite, gold bag, skull, and royals — premium icons pay the big line hits.' },
    ],
    bonuses: [
      { title: 'Free Spins', detail: '3 / 4 / 5 scatters anywhere award 10 / 20 / 40 Free Spins.' },
      { title: 'Wild features', detail: 'Random post-spin stick-ups: Lasso (full reel wild), Dynamite Blast (2×2 wilds), or Shotgun Spray (scattered wilds).' },
      { title: 'Gamble mode', detail: 'In Free Spins, bank wins normally or feed a pot — thumbs up doubles, thumbs down loses the pot.' },
