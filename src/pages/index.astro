  {
    id: 'blackjack',
    title: 'Blackjack',
    subtitle: 'Multi-Hand with 21+3 & Perfect Pairs',
    href: '/blackjack',
    category: 'Table game',
    tileBg: { type: 'blackjack' },
    logo: '/cards/multihand%20logo.png',
    icon: '🃏',
    available: true,
    filterTags: ['table', 'exclusive'],
    releaseOrder: 20,
    isFire: true,
    rtp: '99.40%',
    volatility: 1,
