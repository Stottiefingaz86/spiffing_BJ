    icon: '🌮',
    available: true,
    filterTags: ['slots', 'exclusive'],
    releaseOrder: 70,
    rtp: '96.00%',
    volatility: 4,
    description:
      'Street-party heat on a 7×7 cluster grid — sombreros, chilis, and jar wilds cascading into Free Spins that scale with how many scatters you land.',
    specs: ['7×7', 'Cluster pays', 'Jar multipliers', 'Bonus buy'],
    paytable: [
      { title: 'Clusters', detail: '5+ connected symbols pay; wins cascade and refill the grid.' },
      { title: 'Jar wild', detail: 'Jars sub into clusters and grow a +1 multiplier each time they help a win.' },
      { title: 'Fiesta symbols', detail: 'Sombrero, taco, bottle, chili, drum, cactus, maracas — premium icons lead the pays.' },
    ],
    bonuses: [
      { title: 'Free Spins', detail: '3+ scatters trigger Free Spins — 10 for three, up to 14 for seven or more.' },
      { title: 'Bonus buy', detail: 'Purchase the Free Spins feature for an instant jump into the party.' },
    ],
  },
  {
    id: 'breaking-bandits',
    title: 'Breaking Bandits',
    subtitle: '5x3 Western Slot with Wild Features & Gamble',
    href: '/bandits',
    category: 'Slot game',
    tileBg: { type: 'image', src: '/bandits/bg2.png' },
    logo: '/bandits/logo.png',
    icon: '🤠',
    available: true,
    filterTags: ['slots', 'exclusive'],
    releaseOrder: 65,
    rtp: '95.80%',
    volatility: 5,
    description:
      'Dusty western streets and a mean streak of wilds — 25 paylines, random wild stick-ups, Free Spins, and an optional Gamble pot when you want to ride or die.',
    specs: ['5×3', '25 paylines', 'Wild features', 'Gamble'],
