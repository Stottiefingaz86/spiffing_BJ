    icon: '🗿',
    available: true,
    filterTags: ['slots', 'exclusive'],
    releaseOrder: 10,
    rtp: '95.97%',
    volatility: 3,
    description:
      'Temple ruins and jungle mist — a 5×3 line-pay slot where winning symbols avalanche away, multipliers climb, and Free Falls take the grid into high gear.',
    specs: ['5×3', '20 fixed lines', 'Avalanche', 'RTP ~95.97%*'],
    paytable: [
      { title: 'Lines', detail: '20 fixed paylines, left to right from reel 1. Highest win per line pays.' },
      { title: 'Avalanche', detail: 'Winning symbols clear; new ones drop in. Multipliers climb each cascade (up to ×5 base / ×15 in Free Falls).' },
      { title: 'Wild & Scatter', detail: 'Wild substitutes for paying symbols. Scatter art is presentational on the line sheet.' },
      { title: 'Top symbols', detail: 'Stone mask, feathered serpent, sun mask, eagle, jaguar, and more — higher tiers pay bigger line wins.' },
