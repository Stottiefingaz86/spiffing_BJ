---
import '@fontsource-variable/geist';
import '@fontsource/staatliches';
import '@fontsource/imperial-script';
import '../styles/global.css';

interface Props {
	title?: string;
	/** Allow document scroll (marketing / lobby). Games keep locked viewport. */
	scrollable?: boolean;
}

const { title = 'Multi-Hand Blackjack', scrollable = false } = Astro.props;
---

<!doctype html>
<html lang="en" class:list={[scrollable ? 'min-h-dvh scroll-smooth' : 'h-dvh overflow-hidden']}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<slot name="head" />
	</head>
	<body
		class:list={[
			scrollable
				? 'min-h-dvh overflow-x-hidden bg-[#0e0620] text-white antialiased'
				: 'h-dvh overflow-hidden bg-[#2c1f3f] text-white antialiased',
		]}
	>
		<slot />
	</body>
</html>
